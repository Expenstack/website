---
import { buttonVariants } from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page Not Found / Página Não Encontrada"
  desc="The page you were looking for does not exist. / A página que você está procurando não existe."
  class="grid md:grid-cols-2 md:grid-rows-1 grid-rows-2 p-4 min-h-svh place-content-center"
>
  <div class="max-w-prose mx-auto pt-32 flex gap-4 flex-col">
    <h1 class="text-4xl font-black font-heading">Page Not Found</h1>
    <p>The page you were looking for does not exist.</p>

    <Link href="/en/" class={buttonVariants()} localize={false}>
      Home Page
    </Link>
  </div>
  <div class="max-w-prose mx-auto pt-32 flex gap-4 flex-col">
    <h1 class="text-4xl font-black font-heading">Página Não Encontrada</h1>
    <p>A página que você está procurando não existe.</p>

    <Link href="/pt/" class={buttonVariants()} localize={false}>
      Home Page
    </Link>
  </div>
</Layout>
